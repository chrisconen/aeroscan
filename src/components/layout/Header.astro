---
import Navigation from './Navigation.astro';
import Brand from './Brand.astro';
import Icon from '@/components/Icon.astro';
import { mainNav } from '@/data/navigation';
---
<header class="site-header" id="top">
  <div class="header-inner">
    <Brand /><Navigation />
    <a class="header-quote" href="/kapcsolat">Ajánlatkérés <Icon /></a>
    <span class="language" aria-label="Az oldal nyelve: magyar">HU <span aria-hidden="true">|</span> <span class="language-unavailable" title="Az angol változat még nem érhető el">EN</span></span>
    <button id="mobile-menu-btn" class="menu-toggle" aria-label="Menü megnyitása" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
  </div>
  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobil navigáció" hidden>
    <a href="/">Főoldal</a>
    {mainNav.filter(item => 'children' in item).map(item => 'children' in item && <details><summary>{item.label}</summary>{item.children.map(child => <a href={child.href}>{child.label}</a>)}</details>)}
    <a href="/#rolunk">Rólunk</a><a href="/referenciak">Referenciák</a><a href="/blog">Hírek</a><a href="/kapcsolat">Kapcsolat / Ajánlatkérés</a><a href="tel:+36305696550">+36 30 569 6550</a>
  </nav>
</header>
<script>
  const button = document.querySelector<HTMLButtonElement>('#mobile-menu-btn');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  function closeMenu() {
    if (!menu || !button) return;
    menu.hidden = true;
    button.setAttribute('aria-expanded', 'false');
    button.setAttribute('aria-label', 'Menü megnyitása');
  }
  button?.addEventListener('click', () => {
    if (!menu) return;
    menu.hidden = !menu.hidden;
    button.setAttribute('aria-expanded', String(!menu.hidden));
    button.setAttribute('aria-label', menu.hidden ? 'Menü megnyitása' : 'Menü bezárása');
  });
  menu?.querySelectorAll('a').forEach(a => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && menu && !menu.hidden) { closeMenu(); button?.focus(); }
  });
  document.addEventListener('click', event => {
    if (event.target instanceof Node && !document.querySelector('.site-header')?.contains(event.target)) closeMenu();
  });
  window.matchMedia('(min-width: 901px)').addEventListener('change', event => { if (event.matches) closeMenu(); });
</script>
