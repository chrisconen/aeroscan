---
import Icon from '@/components/Icon.astro';
import { contactInfo } from '@/data/navigation';
---
<section class="contact-cta">
  <div><h2>Készen áll egy új nézőpontra?</h2><p>Beszéljük meg, hogyan segíthetünk Önnek!</p><a href={`tel:${contactInfo.phone.replace(/\s/g, '')}`} class="inline-block mt-4 text-sm text-accent-light">{contactInfo.phone}</a></div>
  <a href="/kapcsolat" class="pill">Kapcsolatfelvétel <Icon /></a>
</section>
