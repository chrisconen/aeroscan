---
import { catalog } from '@/data/catalog';
interface Props {
  city?: string;
  coordinates?: { lat: number; lng: number };
}

const { city, coordinates } = Astro.props;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'AeroScan',
  description: 'Drónos épületfelmérés, keresés-mentés, kisállatkeresés, búváros és fémdetektoros keresés, járőrszolgálat, légi fotó és videó.',
  url: 'https://aeroscan.hu',
  telephone: '+36305696550',
  email: 'info@aeroscan.hu',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Lepke utca 9',
    addressLocality: 'Bodonhely',
    postalCode: '9134',
    addressCountry: 'HU',
  },
  areaServed: city
    ? { '@type': 'City', name: city }
    : { '@type': 'Country', name: 'Magyarország' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'AeroScan szolgáltatások',
    itemListElement: catalog.map(service => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: service.title, url: `https://aeroscan.hu${service.href}`, description: service.description },
    })),
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />
