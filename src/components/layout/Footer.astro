---
import Brand from './Brand.astro';
import Icon from '@/components/Icon.astro';
import { mainNav, socialLinks, contactInfo } from '@/data/navigation';
---
<footer class="site-footer">
  <div class="footer-main">
    <Brand compact />
    <nav class="footer-nav" aria-label="Lábléc navigáció"><a href="/">Főoldal</a><a href="/#szolgaltatasok">Szolgáltatások</a><a href="/#rolunk">Rólunk</a><a href="/referenciak">Referenciák</a><a href="/blog">Hírek</a><a href="/kapcsolat">Kapcsolat</a></nav>
    <div class="social-links">{socialLinks.map(link => <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>{link.icon === 'facebook' ? <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-1.6 19.9v-7H8V12h2.4V9.8c0-2.4 1.4-3.8 3.5-3.8 1 0 2 .2 2 .2v2.4h-1.2c-1.2 0-1.5.7-1.5 1.5V12h2.6l-.4 2.9h-2.2v7A10 10 0 0 0 12 2Z"/></svg> : <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M22 7s-.2-1.5-.8-2.2c-.8-.8-1.6-.8-2-.8C16.4 3.8 12 3.8 12 3.8s-4.4 0-7.2.2c-.4 0-1.2 0-2 .8C2.2 5.5 2 7 2 7s-.2 1.8-.2 3.6v1.8c0 1.8.2 3.6.2 3.6s.2 1.5.8 2.2c.8.8 1.8.8 2.2.9 1.6.1 7 .1 7 .1s4.4 0 7.2-.2c.4 0 1.2 0 2-.8.6-.7.8-2.2.8-2.2s.2-1.8.2-3.6v-1.8C22.2 8.8 22 7 22 7ZM10 15V8l6 3.5Z"/></svg>}</a>)}</div>
    <p class="footer-motto">A levegőből<br/>többet látunk</p><a href="#top" class="circle back-top" aria-label="Vissza az oldal tetejére"><Icon/></a>
  </div>
  <div class="footer-notice" role="note" aria-label="Tájékoztatás a szolgáltató függetlenségéről">
    <span>Fontos tájékoztatás</span>
    <p>Az AeroScan.hu Chris Conen egyéni vállalkozó önálló drónszolgáltatása. <strong>Semmilyen módon nem állunk kapcsolatban az AeroScan Kft.-vel.</strong></p>
  </div>
  <div class="footer-bottom"><span>© {new Date().getFullYear()} AeroScan. Minden jog fenntartva.</span><a href={`mailto:${contactInfo.email}`}>{contactInfo.email}</a><a href="tel:+36305696550">{contactInfo.phone}</a><details class="footer-locations"><summary>Helyszínek és szolgáltatások</summary><div>{mainNav.filter(item => 'children' in item).map(item => 'children' in item && item.children.map(child => <a href={child.href}>{child.label}</a>))}</div></details><a href="/adatvedelmi-nyilatkozat">Adatvédelem</a><a href="/impresszum">Impresszum</a></div>
  <p class="footer-credit">Webdesign és fejlesztés: <a href="https://conendigital.hu" target="_blank" rel="noopener noreferrer">Conen DIGITAL Webdesign Stúdió</a></p>
</footer>
