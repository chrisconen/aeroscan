---
import { Font, getImage } from 'astro:assets';
import defaultOgImage from '@/assets/kereses-mentes-kutya-cica.png';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: ImageMetadata | string;
  type?: 'website' | 'article';
}

const {
  title,
  description,
  canonicalUrl = new URL(Astro.url.pathname, Astro.site).href,
  ogImage = defaultOgImage,
  type = 'website',
} = Astro.props;

// Social cards cap out around 1200px wide; serving the full-size source wastes bytes.
const ogSrc = typeof ogImage === 'string'
  ? ogImage
  : (await getImage({ src: ogImage, width: 1200, format: 'jpeg', quality: 80 })).src;
const ogUrl = new URL(ogSrc, Astro.site).href;

const siteName = 'AeroScan - Drónos keresés és mentés, épületfelmérés, fotózás és videózás';
const fullTitle = title === 'Főoldal' ? siteName : title.includes('AeroScan') ? title : `${title} | AeroScan`;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={ogUrl} />
<meta property="og:locale" content="hu_HU" />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Fonts (self-hosted by Astro) -->
<Font cssVariable="--font-roboto" preload />
<Font cssVariable="--font-manrope" preload />
