---
import Icon from '@/components/Icon.astro';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ogImg from '@/assets/kereso-mento-buvar-balaton.webp';
import diver from '@/assets/kereso-mento-buvar-balaton.webp';
import diverPoster from '@/assets/upgrade/diver-poster.webp';
import LazyVideo from '@/components/LazyVideo.astro';
import ContactCTA from '@/components/home/ContactCTA.astro';
---

<BaseLayout
  title="Keresés búvárral"
  description="Vízbe esett, elsüllyedt tárgyak keresése búvárral a Balatonon, Velencei-tavon és Tisza-tavon. Professzionális keresőbúvár szolgáltatás."
  ogImage={ogImg}
>
  <!-- Hero -->
  <section class="bg-primary py-16 lg:py-20 relative overflow-visible">
    <div class="max-w-7xl mx-auto px-4 text-white relative z-10">
      <h1 class="font-heading text-4xl md:text-5xl font-bold leading-tight mb-4">
        Keresés búvárral
      </h1>
      <p class="text-xl text-accent font-semibold mb-4">
        Vízbe esett, elsüllyedt tárgyak felkutatása — a Balatontól a Tisza-tóig
      </p>
      <p class="text-gray-300 mb-6 max-w-2xl">
        Ha valami értékes esett a vízbe — legyen az telefon, ékszer, kulcs, drón vagy jármű —,
        keresőbúvár szolgáltatásunkkal gyorsan és szakszerűen felkutatjuk.
      </p>
      <a href="https://scubadiver.hu/kereses-mentes.html" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-coral hover:bg-red-700 text-white font-bold py-3 px-8 rounded-lg transition-colors text-lg">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        +36 30 569 6550
      </a>
    </div>
    <Image
      src={diver}
      alt="Kereső-mentő búvár"
      widths={[320, 640]}
      sizes="320px"
      class="absolute bottom-0 right-30 h-[320px] w-auto object-contain translate-y-[30px] z-20 pointer-events-none"
      style="filter: drop-shadow(0 12px 40px rgba(0,0,0,0.45));"
    />
  </section>

  <!-- Video + leírás -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <LazyVideo src="/videok/Balaton-buvar-kereses.mp4" poster={diverPoster} label="Búváros keresés bemutatóvideó" sizes="(max-width: 1024px) 100vw, 50vw" class="rounded-2xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.15)]"/>
        </div>
        <div>
          <h2 class="font-heading text-3xl md:text-4xl font-bold text-primary mb-6">
            Vízbe esett, elsüllyedt tárgyak keresése
          </h2>
          <p class="text-text-light mb-4 leading-relaxed">
            Hajóról, mólóról, kikötőben vízbe esett, elsüllyedt tárgyak keresésére specializálódtunk. Legyen szó telefonról, ékszerről, kulcsról, drónról vagy bármilyen értéktárgyról — szakszerűen és gyorsan felkutatjuk a víz mélyén.
          </p>
          <p class="text-text-light mb-4 leading-relaxed">
            A tapasztalt keresőbúvár szem tudja, hol érdemes keresni: a kikötők oszlopai körül, a hajókról beeső tárgyak általában szűk körben süllyednek le. A balatoni és velencei-tavi mólók végeinél, stégek alatt, hajóutak mentén — ezek a leggyakoribb helyszínek.
          </p>
          <p class="text-text-light mb-6 leading-relaxed">
            Professzionális felszereléssel és több éves keresőbúvár tapasztalattal várjuk a megkereséseket a Balatonon, Velencei-tavon és Tisza-tavon.
          </p>
          <a href="https://scubadiver.hu/kereses-mentes.html" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-primary hover:bg-primary-dark text-white font-semibold py-3 px-6 rounded-lg transition-colors">
            Részletek a ScubaDiver.hu oldalon
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hol dolgozunk -->
  <section class="py-16 lg:py-24 bg-surface">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-primary text-center mb-4">
        Működési terület
      </h2>
      <p class="text-text-light text-lg text-center mb-12 max-w-3xl mx-auto">
        Több éves tapasztalattal rendelkezünk a magyarországi vizeken végzett keresőbúvár feladatokban.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
        <div class="bg-white rounded-2xl p-8 text-center shadow-sm">
          <div class="text-4xl mb-4"><Icon name="mountain" class="detail-icon" /></div>
          <h3 class="font-heading font-bold text-primary text-xl mb-2">Balaton</h3>
          <p class="text-sm text-text-light">Magyarország legnagyobb tava — változatos mélységű és látótávolságú vizek</p>
        </div>
        <div class="bg-white rounded-2xl p-8 text-center shadow-sm">
          <div class="text-4xl mb-4"><Icon name="map" class="detail-icon" /></div>
          <h3 class="font-heading font-bold text-primary text-xl mb-2">Velencei-tó</h3>
          <p class="text-sm text-text-light">Magyarország harmadik legnagyobb tava — sekély, nádasokkal tarkított vízfelület</p>
        </div>
        <div class="bg-white rounded-2xl p-8 text-center shadow-sm">
          <div class="text-4xl mb-4"><Icon name="map" class="detail-icon" /></div>
          <h3 class="font-heading font-bold text-primary text-xl mb-2">Tisza-tó</h3>
          <p class="text-sm text-text-light">Egyedülálló ökológiai környezet — változatos víz alatti terepviszonyokkal</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Amit vállalunk -->
  <section class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4">
      <h2 class="font-heading text-3xl md:text-4xl font-bold text-primary text-center mb-12">
        Mit vállalunk?
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="flex gap-4 p-6 bg-surface rounded-2xl">
          <svg class="w-6 h-6 text-accent mt-1 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <div>
            <h3 class="font-heading font-bold text-primary mb-1">Eltűnt tárgyak keresése</h3>
            <p class="text-sm text-text-light">Telefon, ékszer, kulcs, drón, értéktárgyak felkutatása a víz mélyén.</p>
          </div>
        </div>
        <div class="flex gap-4 p-6 bg-surface rounded-2xl">
          <svg class="w-6 h-6 text-accent mt-1 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <div>
            <h3 class="font-heading font-bold text-primary mb-1">Járművek és roncsok</h3>
            <p class="text-sm text-text-light">Vízbe esett járművek, hajók, roncsok lokalizálása és felkutatása.</p>
          </div>
        </div>
        <div class="flex gap-4 p-6 bg-surface rounded-2xl">
          <svg class="w-6 h-6 text-accent mt-1 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <div>
            <h3 class="font-heading font-bold text-primary mb-1">Baleseti helyszínelés</h3>
            <p class="text-sm text-text-light">Víz alatti helyszínelés, dokumentálás és bizonyítékgyűjtés.</p>
          </div>
        </div>
        <div class="flex gap-4 p-6 bg-surface rounded-2xl">
          <svg class="w-6 h-6 text-accent mt-1 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <div>
            <h3 class="font-heading font-bold text-primary mb-1">Víz alatti kutatás</h3>
            <p class="text-sm text-text-light">Speciális keresési minták alkalmazása a maximális lefedettség érdekében.</p>
          </div>
        </div>
        <div class="flex gap-4 p-6 bg-surface rounded-2xl">
          <svg class="w-6 h-6 text-accent mt-1 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <div>
            <h3 class="font-heading font-bold text-primary mb-1">Eltűnt személyek keresése</h3>
            <p class="text-sm text-text-light">Vízbe esett személyek szakszerű felkutatása.</p>
          </div>
        </div>
        <div class="flex gap-4 p-6 bg-surface rounded-2xl">
          <svg class="w-6 h-6 text-accent mt-1 shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
          <div>
            <h3 class="font-heading font-bold text-primary mb-1">Vészhelyzeti riasztás</h3>
            <p class="text-sm text-text-light">24 órás készenlét vészhelyzet esetén, gyors reagálás.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Együttműködés -->
  <section class="py-16 lg:py-24 bg-surface">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="font-heading text-2xl md:text-3xl font-bold text-primary mb-4">
        Drón + Búvár — Teljes körű keresés & mentés
      </h2>
      <p class="text-text-light text-lg mb-6">
        Az AeroScan drónos keresés & mentés szolgáltatásával és a ScubaDiver.hu búvár keresésével 
        együttműködve teljes körű megoldást kínálunk — a levegőből és a víz alól is.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="https://scubadiver.hu/kereses-mentes.html" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white font-bold py-3 px-8 rounded-lg transition-colors">
          Keresés búvárral — ScubaDiver.hu
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
        <a href="/kereses-mentes" class="inline-flex items-center gap-2 border-2 border-primary text-primary font-semibold py-3 px-8 rounded-lg transition-colors hover:bg-primary hover:text-white">
          Drónos keresés & mentés
        </a>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>
