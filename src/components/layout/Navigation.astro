---
import { mainNav } from '@/data/navigation';
const services = mainNav.find(item => item.label === 'Szolgáltatások');
---
<nav class="desktop-nav" aria-label="Fő navigáció">
  <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Főoldal</a>
  <div class="nav-group">
    <a href="/#szolgaltatasok">Szolgáltatások</a>
    <div class="nav-dropdown">{services && 'children' in services && services.children.map(item => <a href={item.href}>{item.label}</a>)}</div>
  </div>
  <a href="/#rolunk">Rólunk</a><a href="/referenciak">Referenciák</a><a href="/blog">Hírek</a><a href="/kapcsolat">Kapcsolat</a>
</nav>
